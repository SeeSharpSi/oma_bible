#!/usr/bin/env bash
# bsb - quick BSB verse lookup from BSB.sqlite
# Usage:
#   bsb [-n|--no-reference] [-j|--join] <book> <chapter[:verse][-chapter[:verse]]> [ <book> <chapter> ... ]
#   bsb John 1:1
#   bsb --no-reference John 1:1
#   bsb -n Proverbs 3:3-5
#   bsb Luke 2:3-5:12
#   bsb lk 1:9-10
#   bsb Gen 3
#   bsb Luke 3:1-2 John 5
# Options:
#   -n, --no-reference  omit chapter:verse prefix from output
#   -j, --join          join multiple verses on one line (no newlines between verses)

# locate DB (project root, alongside script)
SCRIPT_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
DB=""
for cand in "$SCRIPT_DIR/BSB.sqlite" "./BSB.sqlite" "$(dirname "${BASH_SOURCE[0]:-$0}")/BSB.sqlite" "BSB.sqlite"; do
  if [[ -f "$cand" ]]; then DB="$cand"; break; fi
done
# also check translations_sqlite fallback
if [[ -z "$DB" && -f "$SCRIPT_DIR/translations/translations_sqlite/BSB.sqlite" ]]; then
  DB="$SCRIPT_DIR/translations/translations_sqlite/BSB.sqlite"
fi

if ! command -v sqlite3 >/dev/null 2>&1; then
  echo "error: sqlite3 not found" >&2
  exit 1
fi

if [[ -z "$DB" || ! -f "$DB" ]]; then
  echo "error: BSB.sqlite not found (looked in $SCRIPT_DIR/BSB.sqlite)" >&2
  exit 1
fi

# ---------- CLI flags ----------
NO_REF=0
NO_NEWLINE=0
FILTERED_ARGS=()
for arg in "$@"; do
  case "$arg" in
    -n|--no-reference|--no-references|--no-refs|--no-ref|--no-verse-numbers|--no-verse-number|--no-verses|--no-verse|--only-text|--plain)
      NO_REF=1
      ;;
    -j|--join|--joined|--no-newline|--no-newlines|--no-nl|--no-new-line|--no-new-lines|--single-line|--one-line|--inline|--oneline|--join-lines|--join-verse|--join-verses)
      NO_NEWLINE=1
      ;;
    -h|--help)
      echo "Usage: $0 [-n|--no-reference] [-j|--join] <book> <chapter[:verse][-chapter[:verse]]> [ <book> <chapter> ... ]" >&2
      echo "Options:" >&2
      echo "  -n, --no-reference       omit chapter:verse prefix from output" >&2
      echo "  -j, --join               join multiple verses on one line (no newlines between verses)" >&2
      echo "  -h, --help               show this help" >&2
      echo "Examples:" >&2
      echo "  $0 John 1:1" >&2
      echo "  $0 --no-reference John 1:1" >&2
      echo "  $0 -n Proverbs 3:3-5" >&2
      echo "  $0 Luke 2:3-5:12" >&2
      echo "  $0 lk 1:9-10" >&2
      echo "  $0 Luke 3:1-2 John 5" >&2
      echo "  $0 -j John 1:9-10             # single line" >&2
      echo "  $0 -n -j Proverbs 3:3-5       # combinable with -n" >&2
      exit 0
      ;;
    --)
      continue
      ;;
    -nj|-jn)
      NO_REF=1
      NO_NEWLINE=1
      ;;
    --*)
      echo "error: unknown option '$arg'" >&2
      exit 1
      ;;
    -*)
      # expand combined short flags like -nj, -jn
      _flags="${arg#-}"
      _ok=1
      for (( _k=0; _k<${#_flags}; _k++ )); do
        _ch="${_flags:_k:1}"
        case "$_ch" in
          n) NO_REF=1 ;;
          j) NO_NEWLINE=1 ;;
          h)
            echo "Usage: $0 [-n|--no-reference] [-j|--join] <book> <chapter[:verse][-chapter[:verse]]> [ <book> <chapter> ... ]" >&2
            echo "Options:" >&2
            echo "  -n, --no-reference       omit chapter:verse prefix from output" >&2
            echo "  -j, --join               join multiple verses on one line (no newlines between verses)" >&2
            echo "  -h, --help               show this help" >&2
            exit 0
            ;;
          *) _ok=0; break ;;
        esac
      done
      if (( _ok )); then
        continue
      fi
      echo "error: unknown option '$arg'" >&2
      exit 1
      ;;
    *)
      FILTERED_ARGS+=("$arg")
      ;;
  esac
done

if [[ ${#FILTERED_ARGS[@]} -eq 0 ]]; then
  echo "Usage: $0 [-n|--no-reference] [-j|--join] <book> <chapter[:verse][-chapter[:verse]]> [ <book> <chapter> ... ]" >&2
  echo "Options:" >&2
  echo "  -n, --no-reference       omit chapter:verse prefix from output" >&2
  echo "  -j, --join               join multiple verses on one line (no newlines between verses)" >&2
  echo "Examples:" >&2
  echo "  $0 John 1:1" >&2
  echo "  $0 --no-reference John 1:1" >&2
  echo "  $0 -n Proverbs 3:3-5" >&2
  echo "  $0 Luke 2:3-5:12" >&2
  echo "  $0 lk 1:9-10" >&2
  echo "  $0 Luke 3:1-2 John 5" >&2
  echo "  $0 -j John 1:9-10" >&2
  echo "  $0 -n -j John 1:9-10" >&2
  exit 1
fi

if (( NO_REF )); then
  SELECT_EXPR="text"
else
  SELECT_EXPR="chapter || ':' || verse || ' ' || text"
fi

# buffer for joined output
ALL_LINES=()
emit_result() {
  local _res="$1"
  if (( NO_NEWLINE )); then
    while IFS= read -r _line; do
      [[ -n "$_line" ]] && ALL_LINES+=("$_line")
    done <<< "$_res"
  else
    echo "$_res"
  fi
}

