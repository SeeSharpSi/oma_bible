MAX_BOOK_TOKENS=4

normalize() {
  # lower, remove periods, trim, collapse spaces
  echo "$1" | tr '[:upper:]' '[:lower:]' | tr -d '.' | sed -E 's/^[[:space:]]+|[[:space:]]+$//g; s/[[:space:]]+/ /g'
}

# Try to find book starting at TOKENS[idx], returns "book_num len" or empty
find_book_at() {
  local start=$1
  local n=${#TOKENS[@]}
  local try_len
  for ((try_len=MAX_BOOK_TOKENS; try_len>=1; try_len--)); do
    if (( start + try_len > n )); then continue; fi
    local cand=""
    local i
    for ((i=0; i<try_len; i++)); do
      if [[ -z "$cand" ]]; then cand="${TOKENS[start+i]}"
      else cand="$cand ${TOKENS[start+i]}"
      fi
    done
    local norm
    norm=$(normalize "$cand")
    if [[ -n "${BOOKS[$norm]+x}" ]]; then
      echo "${BOOKS[$norm]} $try_len"
      return 0
    fi
  done
  return 1
}

query_spec() {
  local book=$1
  local spec=$2
  spec=$(echo "$spec" | sed -E 's/^[[:space:]]+|[[:space:]]+$//g')
  [[ -z "$spec" ]] && return 0

  # validation: spec should be like digits with : and -
  local sql=""
  if [[ "$spec" == *-* ]]; then
    local left="${spec%%-*}"
    local right="${spec#*-}"
    left=$(echo "$left" | xargs)
    right=$(echo "$right" | xargs)
    # if extra dashes in right (e.g., malformed), join remainder as right; but we already took first dash, if right still contains dash, treat as invalid and query left only?
    if [[ "$left" == *:* && "$right" == *:* ]]; then
      local lc="${left%%:*}"
      local lv="${left#*:}"
      local rc="${right%%:*}"
      local rv="${right#*:}"
      # ensure numeric
      if ! [[ "$lc" =~ ^[0-9]+$ && "$lv" =~ ^[0-9]+$ && "$rc" =~ ^[0-9]+$ && "$rv" =~ ^[0-9]+$ ]]; then
        echo "warning: invalid reference '$spec'" >&2
        return 1
      fi
      if (( lc == rc )); then
        # same chapter verse range
        local v_low=$lv
        local v_high=$rv
        if (( v_low > v_high )); then local tmp=$v_low; v_low=$v_high; v_high=$tmp; fi
        sql="SELECT $SELECT_EXPR FROM verses WHERE book=$book AND chapter=$lc AND verse BETWEEN $v_low AND $v_high ORDER BY verse;"
      else
        # ensure lc < rc ; swap if needed?
        if (( lc > rc )); then
          # swap to make ordered range
          local tmpc=$lc; local tmpv=$lv; lc=$rc; lv=$rv; rc=$tmpc; rv=$tmpv
        fi
        sql="SELECT $SELECT_EXPR FROM verses WHERE book=$book AND ((chapter=$lc AND verse >= $lv) OR (chapter > $lc AND chapter < $rc) OR (chapter=$rc AND verse <= $rv)) ORDER BY chapter, verse;"
      fi
    elif [[ "$left" == *:* && "$right" != *:* ]]; then
      local ch="${left%%:*}"
      local v1="${left#*:}"
      local v2="$right"
      if ! [[ "$ch" =~ ^[0-9]+$ && "$v1" =~ ^[0-9]+$ && "$v2" =~ ^[0-9]+$ ]]; then
        echo "warning: invalid reference '$spec'" >&2
        return 1
      fi
      if (( v1 > v2 )); then local tmp=$v1; v1=$v2; v2=$tmp; fi
      sql="SELECT $SELECT_EXPR FROM verses WHERE book=$book AND chapter=$ch AND verse BETWEEN $v1 AND $v2 ORDER BY verse;"
    elif [[ "$left" != *:* && "$right" != *:* ]]; then
      local c1="$left"
      local c2="$right"
      if ! [[ "$c1" =~ ^[0-9]+$ && "$c2" =~ ^[0-9]+$ ]]; then
        echo "warning: invalid reference '$spec'" >&2
        return 1
      fi
      if (( c1 > c2 )); then local tmp=$c1; c1=$c2; c2=$tmp; fi
      sql="SELECT $SELECT_EXPR FROM verses WHERE book=$book AND chapter BETWEEN $c1 AND $c2 ORDER BY chapter, verse;"
    else
      # left no colon, right has colon: e.g., 3-5:12
      local c1="$left"
      local rc="${right%%:*}"
      local rv="${right#*:}"
      if ! [[ "$c1" =~ ^[0-9]+$ && "$rc" =~ ^[0-9]+$ && "$rv" =~ ^[0-9]+$ ]]; then
        echo "warning: invalid reference '$spec'" >&2
        return 1
      fi
      if (( c1 > rc )); then
        local tmp=$c1; c1=$rc; rc=$tmp
        # rv stays with rc which is now larger; but original semantics ambiguous, just use same rv
      fi
      if (( c1 == rc )); then
        sql="SELECT $SELECT_EXPR FROM verses WHERE book=$book AND chapter=$c1 AND verse <= $rv ORDER BY verse;"
      else
        sql="SELECT $SELECT_EXPR FROM verses WHERE book=$book AND ((chapter=$c1) OR (chapter > $c1 AND chapter < $rc) OR (chapter=$rc AND verse <= $rv)) ORDER BY chapter, verse;"
      fi
    fi
  else
    if [[ "$spec" == *:* ]]; then
      local ch="${spec%%:*}"
      local v="${spec#*:}"
      if ! [[ "$ch" =~ ^[0-9]+$ && "$v" =~ ^[0-9]+$ ]]; then
        echo "warning: invalid reference '$spec'" >&2
        return 1
      fi
      sql="SELECT $SELECT_EXPR FROM verses WHERE book=$book AND chapter=$ch AND verse=$v ORDER BY verse;"
    else
      local ch="$spec"
      if ! [[ "$ch" =~ ^[0-9]+$ ]]; then
        echo "warning: invalid reference '$spec'" >&2
        return 1
      fi
      sql="SELECT $SELECT_EXPR FROM verses WHERE book=$book AND chapter=$ch ORDER BY verse;"
    fi
  fi

  # execute
  local result
  result=$(sqlite3 "$DB" "$sql")
  if [[ -z "$result" ]]; then
    echo "warning: no verses found for book $book spec '$spec'" >&2
  else
    emit_result "$result"
  fi
}

# ---------- preprocess input ----------
INPUT_RAW="${FILTERED_ARGS[*]}"
# Normalize word/Roman ordinals before digit-letter spacing (fixes 1st/2nd/3rd, I/II/III, First/Second/Third)
# Order: glued forms (longest first) interleaved with conversion to avoid double-split
PROCESSED=$(echo "$INPUT_RAW" | sed -E '
  s/\bIII([A-Za-z])/III \1/gI
  s/\bIII\b/3/gI
  s/\bII([A-Za-z])/II \1/gI
  s/\bII\b/2/gI
  s/\bI([A-Za-z])/I \1/gI
  s/\bI\b/1/gI
  s/\bFirst([A-Za-z])/First \1/gI
  s/\bSecond([A-Za-z])/Second \1/gI
  s/\bThird([A-Za-z])/Third \1/gI
  s/\bFirst\b/1/gI
  s/\bSecond\b/2/gI
  s/\bThird\b/3/gI
  s/\b1st([A-Za-z])/1st \1/gI
  s/\b2nd([A-Za-z])/2nd \1/gI
  s/\b3rd([A-Za-z])/3rd \1/gI
  s/\b1st\b/1/gI
  s/\b2nd\b/2/gI
  s/\b3rd\b/3/gI
  s/([A-Za-z])([0-9])/\1 \2/g
  s/([0-9])([A-Za-z])/\1 \2/g
')
# collapse multiple spaces (sed already); now split into TOKENS
read -ra TOKENS <<< "$PROCESSED"

# ---------- main loop ----------
idx=0
found_any=0
output_all=""

# we will directly output to stdout as we go, but track if any output
while (( idx < ${#TOKENS[@]} )); do
  # find book at idx
  book_info=$(find_book_at "$idx")
  if [[ -z "$book_info" ]]; then
    echo "error: unknown book '${TOKENS[idx]}' at position $((idx+1)). Try: $0 John 1:1" >&2
    # skip token
    idx=$((idx+1))
    continue
  fi
  book_num=$(echo "$book_info" | cut -d' ' -f1)
  book_len=$(echo "$book_info" | cut -d' ' -f2)

  # find next book start
  next_book_idx=-1
  search_start=$((idx + book_len))
  for ((j=search_start; j<${#TOKENS[@]}; j++)); do
    if find_book_at "$j" >/dev/null; then
      next_book_idx=$j
      break
    fi
  done

  spec_end=$(( next_book_idx == -1 ? ${#TOKENS[@]} : next_book_idx ))
  spec_start=$search_start
  spec_count=$((spec_end - spec_start))

  if (( spec_count == 0 )); then
    echo "warning: no chapter/verse given for book '${TOKENS[idx]}' (book $book_num), showing whole book" >&2
    # whole book
    _wb_result=$(sqlite3 "$DB" "SELECT $SELECT_EXPR FROM verses WHERE book=$book_num ORDER BY chapter, verse;")
    if [[ -n "$_wb_result" ]]; then
      emit_result "$_wb_result"
    fi
    found_any=1
    idx=$spec_end
    continue
  fi

  # iterate over raw spec tokens belonging to this book
  for ((s=spec_start; s<spec_end; s++)); do
    raw="${TOKENS[s]}"
    # skip empty
    [[ -z "$raw" ]] && continue
    # split raw by comma/semicolon into parts (inheritance only within raw)
    # use IFS split preserving empty removal
    IFS=',;' read -ra PARTS <<< "$raw"
    last_ch=""
    # need to know if raw had comma: parts length >1 indicates inheritance context
    for part in "${PARTS[@]}"; do
      part=$(echo "$part" | sed -E 's/^[[:space:]]+|[[:space:]]+$//g')
      [[ -z "$part" ]] && continue
      # determine handling with last_ch inheritance for comma case only
      if [[ "$part" == *:* ]]; then
        # contains colon, update last_ch for next comma parts
        # extract left chapter before dash if present
        tmp_left="${part%%-*}"
        if [[ "$tmp_left" == *:* ]]; then
          last_ch="${tmp_left%%:*}"
        else
          # part like "3:1" no dash
          last_ch="${part%%:*}"
          # if part has dash with right colon? e.g., "3-5:2" left no colon but part overall has colon via right
          # then last_ch not accurate but okay
          # fallback: find first chapter number before colon
          if [[ -z "$last_ch" || ! "$last_ch" =~ ^[0-9]+$ ]]; then
            # try to extract first number before colon anywhere
            last_ch=$(echo "$part" | grep -oE '[0-9]+:' | head -1 | tr -d ':')
          fi
        fi
        # query directly
        query_spec "$book_num" "$part"
        found_any=1
      else
        # no colon
        if [[ "$part" == *-* ]]; then
          # dash without colon
          if [[ -n "$last_ch" && ${#PARTS[@]} -gt 1 ]]; then
            # inheritance: treat as verse range in last_ch
            # reconstruct as last_ch:part
            query_spec "$book_num" "${last_ch}:${part}"
          else
            # treat as chapter range
            query_spec "$book_num" "$part"
          fi
          found_any=1
          # last_ch stays?
        else
          # single number without colon
          if [[ -n "$last_ch" && ${#PARTS[@]} -gt 1 ]]; then
            query_spec "$book_num" "${last_ch}:${part}"
          else
            query_spec "$book_num" "$part"
          fi
          found_any=1
          # if parts >1, keep last_ch; else single chapter reference may be whole chapter, not verse, so no update?
        fi
      fi
    done
  done

  idx=$spec_end
done

if (( NO_NEWLINE && ${#ALL_LINES[@]} > 0 )); then
  # join with single space
  IFS=' ' echo "${ALL_LINES[*]}"
fi

if (( found_any == 0 )); then
  exit 1
fi
